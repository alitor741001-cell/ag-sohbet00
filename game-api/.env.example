# ============================================================================
#  game-api — yerel geliştirme şablonu
#  Bu dosyayı ".env" olarak kopyalayın ve değerleri kendi ortamınıza göre
#  doldurun.  .env ASLA depoya eklenmez ve ASLA istemciye gönderilmez.
# ============================================================================

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_REQUESTS=true
SERVICE_NAME=game-api
SERVICE_VERSION=0.1.0

# --- Supabase (yalnızca sunucu tarafı) --------------------------------------
# Ayna Supabase projenizin REST adresi.
SUPABASE_URL=https://<proje-ref>.supabase.co
# Servis rolü anahtarı: yalnızca sunucuda durur, istemciye asla verilmez.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# Kullanıcı tokenlarının doğrulanması (en az biri zorunlu):
#  • Asimetrik imzalama (önerilir): JWKS adresi
SUPABASE_JWKS_URL=https://<proje-ref>.supabase.co/auth/v1/.well-known/jwks.json
#  • Simetrik imzalama (HS256): paylaşılan gizli anahtar
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# İsteğe bağlı: beklenen token veren (issuer) adresi.
SUPABASE_JWT_ISSUER=

# --- Servis tokenı ----------------------------------------------------------
# En az 32 karakter, rastgele. Base44 arka ucu bu anahtarla servis tokenı imzalar.
GAME_API_KEY=
# supabase | service | both  (hem kullanıcı hem servis tokenı kabul edilsin: both)
AUTH_MODE=both

# --- Rol çözümlemesi --------------------------------------------------------
# Rol her zaman veritabanından okunur (en az yetki ilkesi); okunamazsa token
# içindeki rol kullanılır ve en fazla "user" olur.
ROLE_LOOKUP_ENABLED=true
ROLE_CACHE_TTL_MS=30000
USERS_TABLE=users
USERS_ID_COLUMN=id
USERS_ROLE_COLUMN=role

# --- Okunacak oyun tabloları ------------------------------------------------
# Kendi Supabase ayna şemanıza göre ayarlayın. Sunucu YALNIZCA SELECT yapar ve
# yalnızca aşağıdaki kolonları dışarı verir (parola, moderatör listeleri vb. asla).
ROOMS_TABLE=rooms
ROOMS_ID_COLUMN=id
ROOMS_STATUS_COLUMN=status
ROOMS_STATUS_ACTIVE=active
ROOMS_ORDER_COLUMN=created_date
ROOMS_PUBLIC_COLUMNS=id,name,status,room_type,seat_count,max_users,created_date

# --- Güvenlik ---------------------------------------------------------------
# Tarayıcıdan çağrılacaksa izinli kaynaklar (virgülle). Boş = yalnızca sunucudan sunucuya.
CORS_ORIGINS=https://ag-sohbet.base44.app
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY=true
MAX_PAGE_SIZE=50

# Geliştirme kolaylığı: üretimde ASLA true olmamalı.
ALLOW_INSECURE_DEV=false

# --- Finansal işlemler kilidi -----------------------------------------------
# Coin bakiyesi, bahis kesintisi ve para çekme uç noktaları bu API'de yoktur ve
# bu bayrak açılmadan eklenemez. Açmak için yasal uygunluk + güvenlik incelemesi
# onayının ayrıca işaretlenmesi gerekir (iki anahtar birlikte).
FINANCIAL_OPERATIONS_ENABLED=false
FINANCIAL_LEGAL_REVIEW_APPROVED=false