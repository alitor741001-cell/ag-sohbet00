{
  "name": "filmkeyfi-game-api",
  "version": "0.1.0",
  "private": true,
  "description": "FILMKEYFİ için bağımsız, salt-okunur oyun API'si (Google Cloud Run). Mevcut Base44 uygulamasından ve oyunlarından tamamen ayrıdır.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node src/server.js",
