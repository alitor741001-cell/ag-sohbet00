{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": "string",
    "slug": "string",
    "type": {
      "type": "string",
      "enum": [
        "movie",
        "series"
      ],
      "default": "movie"
    },
    "icon": "string",
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug",
    "icon"
  ]
}