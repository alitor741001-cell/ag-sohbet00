{
  "name": "GiftTransfer",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "send",
        "withdraw"
      ],
      "default": "send"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "rejected"
      ],
      "default": "completed"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string",
      "default": ""
    },
    "recipient_id": {
      "type": "string",
      "default": ""
    },
    "recipient_name": {
      "type": "string",
      "default": ""
    },
    "dollars": {
      "type": "number",
      "default": 0
    },
    "tl_amount": {
      "type": "number",
      "default": 0
    },
    "rate": {
      "type": "number",
      "default": 0
    },
    "coins": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "kind",
    "sender_id",
    "dollars"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}