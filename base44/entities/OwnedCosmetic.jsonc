{
  "name": "OwnedCosmetic",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "seat-frame",
        "vip-frame"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "crop": {
      "type": "object"
    },
    "remove_white": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "integer"
    },
    "request_id": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "owned"
      ],
      "default": "pending"
    }
  },
  "required": [
    "owner_id",
    "product_id",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}