{
  "name": "RocketRound",
  "type": "object",
  "properties": {
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "variant": {
      "type": "string",
      "enum": [
        "rocket"
      ],
      "default": "rocket"
    },
    "status": {
      "type": "string",
      "enum": [
        "betting",
        "running",
        "crashed"
      ],
      "default": "betting"
    },
    "phase_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "crash_at": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "round_no",
    "status",
    "crash_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}