{
  "name": "Payment",
  "type": "object",
  "properties": {
    "user_id": "string",
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "TRY"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "method": "string",
    "plan_id": "string",
    "plan_name": "string",
    "transaction_id": "string",
    "shopier_order_id": "string"
  },
  "required": [
    "user_id",
    "method",
    "plan_id"
  ]
}