{
  "name": "MafyaChat",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "phase": {
      "type": "string",
      "default": "day"
    },
    "user_id": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "user",
        "system"
      ],
      "default": "user"
    }
  },
  "required": [
    "room_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}