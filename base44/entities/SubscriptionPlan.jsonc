{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": "string",
    "description": "string",
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "TRY"
    },
    "duration_days": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "description"
  ]
}