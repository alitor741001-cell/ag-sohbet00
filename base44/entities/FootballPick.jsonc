{
  "name": "FootballPick",
  "type": "object",
  "properties": {
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string",
      "default": ""
    },
    "user_avatar": {
      "type": "string",
      "default": ""
    },
    "team_id": {
      "type": "string"
    },
    "stake": {
      "type": "number",
      "default": 0
    },
    "payout": {
      "type": "number",
      "default": 0
    },
    "settled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "round_no",
    "user_id",
    "team_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}