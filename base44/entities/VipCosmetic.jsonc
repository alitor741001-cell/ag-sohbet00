{
  "name": "VipCosmetic",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "badge",
        "frame",
        "banner",
        "mic",
        "bubble",
        "card",
        "ride",
        "room-card",
        "seat",
        "name",
        "avatar"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 5,
      "maximum": 12,
      "default": 5
    },
    "owned_levels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 5,
        "maximum": 12
      },
      "default": []
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "owner_id",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}