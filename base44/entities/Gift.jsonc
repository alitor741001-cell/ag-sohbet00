{
  "name": "Gift",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83c\udf81"
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "k_value": {
      "type": "number",
      "default": 10
    },
    "category": {
      "type": "string",
      "default": "Klasik"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "model_url": {
      "type": "string",
      "default": ""
    },
    "animation_url": {
      "type": "string",
      "default": ""
    },
    "model_kind": {
      "type": "string",
      "enum": [
        "auto",
        "heart",
        "rose",
        "bouquet",
        "ring",
        "bear",
        "car",
        "diamond",
        "castle",
        "crown",
        "rocket",
        "galaxy",
        "giftbox",
        "chocolate",
        "letter",
        "cake",
        "star",
        "trophy",
        "fireworks",
        "jet",
        "yacht",
        "island",
        "butterfly",
        "watch",
        "ingot",
        "wand"
      ],
      "default": "auto"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}