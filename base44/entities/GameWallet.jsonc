{
  "name": "GameWallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "coins": {
      "type": "number",
      "default": 100000
    },
    "bet": {
      "type": "number",
      "default": 100
    },
    "rocket_bet": {
      "type": "number",
      "default": 500
    },
    "rocket_bet_2": {
      "type": "number",
      "default": 500
    },
    "rocket_auto": {
      "type": "number",
      "default": 0
    },
    "rocket_auto_2": {
      "type": "number",
      "default": 0
    },
    "rocket_paid_bets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "grand": {
      "type": "number",
      "default": 0
    },
    "pool_mini": {
      "type": "number",
      "default": 5000
    },
    "pool_big": {
      "type": "number",
      "default": 25000
    },
    "pool_mega": {
      "type": "number",
      "default": 250000
    },
    "pool_xmega": {
      "type": "number",
      "default": 400000
    },
    "free_spins": {
      "type": "integer",
      "default": 0
    },
    "dede_free_spins": {
      "type": "integer",
      "default": 0
    },
    "seker_free_spins": {
      "type": "integer",
      "default": 0
    },
    "elimin_free_spins": {
      "type": "integer",
      "default": 0
    },
    "elimin_chests": {
      "type": "integer",
      "default": 0
    },
    "elimin_jackpot": {
      "type": "number",
      "default": 0
    },
    "elimin_session_spins": {
      "type": "integer",
      "default": 0
    },
    "session_spins": {
      "type": "integer",
      "default": 0
    },
    "dede_session_spins": {
      "type": "integer",
      "default": 0
    },
    "seker_session_spins": {
      "type": "integer",
      "default": 0
    },
    "sekerli_session_spins": {
      "type": "integer",
      "default": 0
    },
    "lines": {
      "type": "number",
      "default": 50
    },
    "spins": {
      "type": "integer",
      "default": 0
    },
    "total_won": {
      "type": "number",
      "default": 0
    },
    "total_won_slot": {
      "type": "number",
      "default": 0
    },
    "total_won_dede": {
      "type": "number",
      "default": 0
    },
    "total_won_fruit": {
      "type": "number",
      "default": 0
    },
    "total_won_seker": {
      "type": "number",
      "default": 0
    },
    "total_won_sekerli": {
      "type": "number",
      "default": 0
    },
    "total_won_roulette": {
      "type": "number",
      "default": 0
    },
    "total_won_rocket": {
      "type": "number",
      "default": 0
    },
    "total_won_futbol": {
      "type": "number",
      "default": 0
    },
    "total_won_elimin": {
      "type": "number",
      "default": 0
    },
    "futbol_mode": {
      "type": "string",
      "enum": [
        "normal",
        "gelismis",
        "usta"
      ],
      "default": "normal"
    },
    "futbol_today": {
      "type": "number",
      "default": 0
    },
    "futbol_today_date": {
      "type": "string",
      "default": ""
    },
    "admin_granted": {
      "type": "boolean",
      "default": false
    },
    "last_bonus_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_spin_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}