{
  "name": "GameWallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "coins": {
      "type": "number",
      "default": 100000
    },
    "bet": {
      "type": "number",
      "default": 100
    },
    "rocket_bet": {
      "type": "number",
      "default": 500
    },
    "grand": {
      "type": "number",
      "default": 0
    },
    "pool_mini": {
      "type": "number",
      "default": 5000
    },
    "pool_big": {
      "type": "number",
      "default": 25000
    },
    "pool_mega": {
      "type": "number",
      "default": 250000
    },
    "pool_xmega": {
      "type": "number",
      "default": 400000
    },
    "free_spins": {
      "type": "integer",
      "default": 0
    },
    "lines": {
      "type": "number",
      "default": 50
    },
    "spins": {
      "type": "integer",
      "default": 0
    },
    "total_won": {
      "type": "number",
      "default": 0
    },
    "admin_granted": {
      "type": "boolean",
      "default": false
    },
    "last_bonus_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_spin_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}