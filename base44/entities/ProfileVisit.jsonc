{
  "name": "ProfileVisit",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "visitor_id": {
      "type": "string"
    },
    "visited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "profile_id",
    "visitor_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.profile_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}