{
  "name": "GameConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "main"
    },
    "min_bet": {
      "type": "integer",
      "default": 100
    },
    "max_bet": {
      "type": "integer",
      "default": 100000
    },
    "bet_steps": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        100,
        500,
        1000,
        2000,
        5000,
        10000,
        25000,
        50000,
        100000
      ]
    },
    "start_coins": {
      "type": "integer",
      "default": 1000
    },
    "jackpot_mini": {
      "type": "integer",
      "default": 250000
    },
    "jackpot_mini_base": {
      "type": "integer",
      "default": 250000
    },
    "jackpot_major": {
      "type": "integer",
      "default": 1250000
    },
    "jackpot_major_base": {
      "type": "integer",
      "default": 1250000
    },
    "jackpot_mega": {
      "type": "integer",
      "default": 5000000
    },
    "jackpot_mega_base": {
      "type": "integer",
      "default": 5000000
    },
    "jackpot_growth": {
      "type": "number",
      "default": 0.01
    },
    "slot_enabled": {
      "type": "boolean",
      "default": true
    },
    "crash_enabled": {
      "type": "boolean",
      "default": true
    },
    "jackpot_enabled": {
      "type": "boolean",
      "default": true
    },
    "auto_max": {
      "type": "integer",
      "default": 100
    },
    "crash_min": {
      "type": "number",
      "default": 1.01
    },
    "crash_max": {
      "type": "number",
      "default": 50
    },
    "crash_wait_seconds": {
      "type": "integer",
      "default": 8
    },
    "daily_limit": {
      "type": "integer",
      "default": 0
    },
    "xp_per_bet": {
      "type": "number",
      "default": 0.01
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}