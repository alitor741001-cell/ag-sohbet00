{
  "name": "DirectCall",
  "type": "object",
  "properties": {
    "caller_id": {
      "type": "string"
    },
    "caller_name": {
      "type": "string"
    },
    "caller_avatar": {
      "type": "string"
    },
    "caller_frame": {
      "type": "string"
    },
    "caller_frame_scale": {
      "type": "number"
    },
    "caller_gender": {
      "type": "string",
      "default": ""
    },
    "callee_id": {
      "type": "string"
    },
    "callee_name": {
      "type": "string"
    },
    "callee_avatar": {
      "type": "string"
    },
    "callee_frame": {
      "type": "string"
    },
    "callee_frame_scale": {
      "type": "number"
    },
    "callee_gender": {
      "type": "string",
      "default": ""
    },
    "video_fee_status": {
      "type": "string",
      "enum": [
        "",
        "pending",
        "accepted",
        "rejected"
      ],
      "default": ""
    },
    "video_fee_by": {
      "type": "string",
      "default": ""
    },
    "video_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "conversation_id": {
      "type": "string"
    },
    "silent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "ringing",
        "accepted",
        "rejected",
        "ended",
        "cancelled"
      ],
      "default": "ringing"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_by": {
      "type": "string"
    }
  },
  "required": [
    "caller_id",
    "callee_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.caller_id": "{{user.id}}"
        },
        {
          "data.callee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.caller_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.caller_id": "{{user.id}}"
        },
        {
          "data.callee_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}