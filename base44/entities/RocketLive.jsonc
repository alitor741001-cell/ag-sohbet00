{
  "name": "RocketLive",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "rocket-live"
    },
    "variant": {
      "type": "string",
      "enum": [
        "rocket",
        "otobus"
      ],
      "default": "rocket"
    },
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "betting",
        "running",
        "crashed"
      ],
      "default": "betting"
    },
    "phase_ends_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string",
      "default": ""
    },
    "crash_at": {
      "type": "number",
      "default": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round_no": {
            "type": "integer"
          },
          "crash_at": {
            "type": "number"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "round_no",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}