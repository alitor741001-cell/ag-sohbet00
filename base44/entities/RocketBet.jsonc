{
  "name": "RocketBet",
  "type": "object",
  "properties": {
    "round_id": {
      "type": "string"
    },
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "variant": {
      "type": "string",
      "enum": [
        "rocket"
      ],
      "default": "rocket"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "slot": {
      "type": "integer",
      "default": 1
    },
    "bet": {
      "type": "number",
      "default": 0
    },
    "auto_at": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cashed",
        "lost"
      ],
      "default": "active"
    },
    "cashout_at": {
      "type": "number",
      "default": 0
    },
    "payout": {
      "type": "number",
      "default": 0
    },
    "settlement_version": {
      "type": "integer",
      "default": 0
    },
    "payout_credited": {
      "type": "boolean",
      "default": false
    },
    "cancelled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "round_id",
    "user_id",
    "bet"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}