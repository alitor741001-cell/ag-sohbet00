{
  "name": "MafyaRoom",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "password": {
      "type": "string",
      "default": ""
    },
    "host_id": {
      "type": "string",
      "default": ""
    },
    "host_name": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "reveal",
        "night",
        "day",
        "vote",
        "finished"
      ],
      "default": "waiting"
    },
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "phase_ends_at": {
      "type": "string",
      "default": ""
    },
    "capacity": {
      "type": "integer",
      "default": 8
    },
    "players": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "default": ""
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "avatar": {
            "type": "string",
            "default": ""
          },
          "seat": {
            "type": "integer",
            "default": 0
          },
          "alive": {
            "type": "boolean",
            "default": true
          },
          "ready": {
            "type": "boolean",
            "default": false
          },
          "voted": {
            "type": "boolean",
            "default": false
          },
          "role": {
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "last_votes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "default": ""
          },
          "target_name": {
            "type": "string",
            "default": ""
          },
          "count": {
            "type": "integer",
            "default": 0
          }
        }
      }
    },
    "winner_side": {
      "type": "string",
      "default": ""
    },
    "final_shown": {
      "type": "boolean",
      "default": false
    },
    "last_action": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}