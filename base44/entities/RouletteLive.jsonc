{
  "name": "RouletteLive",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "live"
    },
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "betting",
        "spinning"
      ],
      "default": "betting"
    },
    "started_at": {
      "type": "string"
    },
    "phase_ends_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "default": 0
    },
    "index": {
      "type": "integer",
      "default": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round_no": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "round_no",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}