{
  "name": "FaceCheck",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string",
      "default": ""
    },
    "face_uri": {
      "type": "string",
      "default": ""
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "trusted_devices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "balance_devices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "balance_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_device": {
      "type": "string",
      "default": ""
    },
    "duplicate_of": {
      "type": "string",
      "default": ""
    },
    "duplicate_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}