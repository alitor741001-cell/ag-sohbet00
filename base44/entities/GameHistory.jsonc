{
  "name": "GameHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "enum": [
        "slot",
        "jackpot",
        "crash"
      ],
      "default": "slot"
    },
    "bet": {
      "type": "integer",
      "default": 0
    },
    "payout": {
      "type": "integer",
      "default": 0
    },
    "multiplier": {
      "type": "number",
      "default": 0
    },
    "detail": {
      "type": "string",
      "default": ""
    },
    "request_id": {
      "type": "string",
      "default": ""
    },
    "round_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id",
    "game",
    "bet"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}