    "season_number": {
      "type": "number",
      "default": 1
    },
    "episode_number": {
      "type": "number",
      "default": 1
    },
    "title": "string",
    "description": "string",
    "video_url": "string",
    "thumbnail": "string",
    "duration": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "movie_id",
    "title",
    "description"
  ]
}