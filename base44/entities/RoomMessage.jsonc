{
  "name": "RoomMessage",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "default": ""
    },
    "room_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "gift": {
      "type": "string"
    },
    "gift_to_id": {
      "type": "string",
      "default": ""
    },
    "gift_to_name": {
      "type": "string",
      "default": ""
    },
    "gift_emoji": {
      "type": "string",
      "default": ""
    },
    "gift_k": {
      "type": "number",
      "default": 0
    },
    "notice_key": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "slot_win",
        "gift"
      ],
      "default": "user"
    }
  },
  "required": [
    "room_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}