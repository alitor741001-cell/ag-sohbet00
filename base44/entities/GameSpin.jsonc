{
  "name": "GameSpin",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "bet": {
      "type": "number",
      "default": 100
    },
    "cost": {
      "type": "number",
      "default": 0
    },
    "win": {
      "type": "number",
      "default": 0
    },
    "coins_after": {
      "type": "number",
      "default": 0
    },
    "big_win": {
      "type": "boolean",
      "default": false
    },
    "jackpot": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "bet"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}