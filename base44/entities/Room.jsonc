{
  "name": "Room",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "movie_id": {
      "type": "string"
    },
    "movie_title": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "room_number": {
      "type": "integer",
      "default": 0
    },
    "personal_room_code": {
      "type": "string",
      "default": ""
    },
    "max_users": {
      "type": "integer",
      "default": 10
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true
    },
    "chat_seated_only": {
      "type": "boolean",
      "default": false
    },
    "voice_enabled": {
      "type": "boolean",
      "default": false
    },
    "room_type": {
      "type": "string",
      "enum": [
        "watch",
        "voice"
      ],
      "default": "watch"
    },
    "seat_count": {
      "type": "integer",
      "default": 0
    },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "frame": {
            "type": "string"
          },
          "frame_scale": {
            "type": "number"
          },
          "locked": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          }
        }
      },
      "default": []
    },
    "seat_invites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "seat_index": {
            "type": "integer"
          },
          "invited_by": {
            "type": "string"
          },
          "invited_by_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "number_board": {
      "type": "boolean",
      "default": false
    },
    "number_board_reset_seat": {
      "type": "boolean",
      "default": true
    },
    "number_board_reset_room": {
      "type": "boolean",
      "default": true
    },
    "number_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "chat_auto_delete_minutes": {
      "type": "integer",
      "default": 0
    },
    "chat_auto_delete_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "current_time": {
      "type": "number",
      "default": 0
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "is_personal": {
      "type": "boolean",
      "default": false
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "room_moderators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "banned_users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "banned_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "recent_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "left_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "muted": {
            "type": "boolean"
          },
          "speaking": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "movie_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.hidden": false
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.participants.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}