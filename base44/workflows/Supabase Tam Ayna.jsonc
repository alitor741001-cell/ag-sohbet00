  "description": "T\u00fcm koleksiyonlar\u0131 Supabase'e ta\u015f\u0131r ve kayna\u011f\u0131ndan silinen kay\u0131tlar\u0131 aynadan d\u00fc\u015f\u00fcr\u00fcr",
  "name": "Supabase Tam Ayna",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "supabase_full_mirror",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "aynala": {
          "call": "invoke_backend_function",
          "with": {
